        "attachment": {"type": "belongsTo", "entity": "Attachment"},
        "approvedBy": {"type": "belongsTo", "entity": "User"},
        "supersededByDocument": {"type": "belongsTo", "entity": "EmployeeHolidayDocument"}
    },
    "indexes": {
        "issueKeyUnique": {"unique": true, "columns": ["issueKey"]},
        "verificationCodeHashUnique": {"unique": true, "columns": ["verificationCodeHash"]},
        "requestMonthVersionUnique": {"unique": true, "columns": ["requestId", "month", "version"]},
