<td><strong>{{numeAngajat}}</strong><div class="small text-muted">{{dataAngajare}}</div>{{#if initializat}}<div class="small"><strong>{{istoricEticheta}}</strong>{{#if istoric.length}}<ul class="list-unstyled">{{#each istoric}}<li>{{dataAfisata}} · {{tipAfisat}} · {{numarZileAfisat}}{{#if motiv}} · {{motiv}}{{/if}}{{#if actor}} · {{actor}}{{/if}}</li>{{/each}}</ul>{{else}}<div class="text-muted">—</div>{{/if}}</div>{{/if}}</td>
<td><div class="field" data-name="zileAnuale">{{{zileAnuale}}}</div></td>
<td>{{#unless initializat}}<label class="small text-muted">{{disponibileInitialEticheta}}</label><div class="field" data-name="zileDisponibileAnCurent">{{{zileDisponibileAnCurent}}}</div>{{else}}{{disponibileAnCurent}}{{/unless}}</td>
<td>{{#unless initializat}}<label class="small text-muted">{{reportateInitialEticheta}}</label><div class="field" data-name="zileReportateAnAnterior">{{{zileReportateAnAnterior}}}</div>{{else}}{{disponibileReportate}}{{/unless}}</td>
<td>{{#if initializat}}{{dataAcordareAfisata}}{{else}}<div class="field" data-name="dataUrmatoareiAcordari">{{{dataUrmatoareiAcordari}}}</div>{{/if}}</td>
<td class="text-right"><button class="btn btn-primary btn-sm" data-action="salveaza">{{#if initializat}}{{salvare}}{{else}}{{initializare}}{{/if}}</button>{{#if initializat}}<div class="form-group text-left"><label class="small">{{dataNouaAcordareEticheta}}</label><div class="field" data-name="dataCorectieAcordare">{{{dataUrmatoareiAcordari}}}</div></div><div class="form-group text-left"><label class="small">{{motivProgramAcordareEticheta}}</label><input type="text" class="form-control input-sm" data-camp="motivProgramAcordare"></div><button class="btn btn-default btn-sm" data-action="corecteazaProgramAcordare">{{corecteazaProgramAcordareEticheta}}</button><hr><div class="form-group text-left"><label class="small">{{diferentaEticheta}}</label><div class="field" data-name="diferentaCorectie">{{{diferentaCorectie}}}</div></div><div class="form-group text-left"><label class="small">{{motivEticheta}}</label><input type="text" class="form-control input-sm" data-camp="motivCorectie"></div><button class="btn btn-default btn-sm" data-action="corecteaza">{{corecteazaEticheta}}</button>{{/if}}</td>
