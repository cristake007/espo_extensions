<div class="management-angajati administrare-extensie-page">
    <header class="administrare-extensie-antet">
        <span class="administrare-extensie-icon administrare-extensie-icon-mare" aria-hidden="true">
            <span class="fas fa-user-cog"></span>
        </span>
        <div>
            <div class="administrare-extensie-spratitlu">{{spratitlu}}</div>
            <h2>{{titlu}}</h2>
            <p>{{explicatie}}</p>
        </div>
    </header>

    <section class="administrare-extensie-panou">
        <div class="administrare-extensie-panou-antet">
            <span class="administrare-extensie-icon" aria-hidden="true">
                <span class="fas fa-th-large"></span>
            </span>
            <div>
                <h4>{{zoneAdministrare}}</h4>
                <p>{{explicatieZoneAdministrare}}</p>
            </div>
        </div>

        <div class="administrare-extensie-carduri">
            <a class="administrare-extensie-card" href="#GestionareAngajati/setariCondica">
                <span class="administrare-extensie-icon" aria-hidden="true">
                    <span class="fas fa-sliders-h"></span>
                </span>
                <span class="administrare-extensie-card-text">
                    <strong>{{setariCondica}}</strong>
                    <small>{{explicatieSetari}}</small>
                </span>
                <span class="fas fa-chevron-right administrare-extensie-card-sageata" aria-hidden="true"></span>
            </a>

            <a class="administrare-extensie-card" href="#GestionareAngajati/profiluriAngajati">
                <span class="administrare-extensie-icon" aria-hidden="true">
                    <span class="fas fa-id-card"></span>
                </span>
                <span class="administrare-extensie-card-text">
                    <strong>{{profiluriAngajati}}</strong>
                    <small>{{explicatieProfiluri}}</small>
                </span>
                <span class="fas fa-chevron-right administrare-extensie-card-sageata" aria-hidden="true"></span>
            </a>

            <a class="administrare-extensie-card" href="#GestionareAngajati/concedii">
                <span class="administrare-extensie-icon" aria-hidden="true">
                    <span class="fas fa-umbrella-beach"></span>
                </span>
                <span class="administrare-extensie-card-text">
                    <strong>{{setariConcedii}}</strong>
                    <small>{{explicatieConcedii}}</small>
                </span>
                <span class="fas fa-chevron-right administrare-extensie-card-sageata" aria-hidden="true"></span>
            </a>
        </div>
    </section>
</div>
