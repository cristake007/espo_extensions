<div class="page-header">
    <h3>{{titlu}}</h3>
    <p class="text-muted">{{explicatie}}</p>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><strong>{{titlu}}</strong></div>
    <div class="panel-body">
        <a class="btn btn-default btn-block text-left" href="#GestionareAngajati/setariCondica">
            <span class="fas fa-sliders-h"></span>
            <strong>{{setariCondica}}</strong>
            <span class="text-muted"> — {{explicatieSetari}}</span>
        </a>
        <a class="btn btn-default btn-block text-left" href="#GestionareAngajati/profiluriAngajati">
            <span class="fas fa-id-card"></span>
            <strong>{{profiluriAngajati}}</strong>
            <span class="text-muted"> — {{explicatieProfiluri}}</span>
        </a>
        <a class="btn btn-default btn-block text-left" href="#GestionareAngajati/concedii">
            <span class="fas fa-umbrella-beach"></span>
            <strong>{{setariConcedii}}</strong>
            <span class="text-muted"> — {{explicatieConcedii}}</span>
        </a>
    </div>
</div>
