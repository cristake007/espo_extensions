{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "readOnly": true
        },
        "date": {
            "type": "date",
            "required": true,
            "readOnly": true
        },
        "status": {
            "type": "enum",
            "options": ["AtWork", "Holiday", "BusinessTrip"],
            "required": true,
            "readOnly": true,
            "style": {
                "AtWork": "success",
                "Holiday": "info",
                "BusinessTrip": "warning"
            }
        },
        "source": {
            "type": "enum",
            "options": ["Self"],
            "required": true,
            "readOnly": true
        },
        "user": {
            "type": "link",
            "entity": "User",
            "required": true,
            "readOnly": true
        },
        "markedAt": {
            "type": "datetime",
            "required": true,
            "readOnly": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "user": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "indexes": {
        "userDateUnique": {
            "unique": true,
            "columns": ["userId", "date"]
        },
        "dateStatus": {
            "columns": ["date", "status"]
        }
    },
    "noDeletedAttribute": true
}
